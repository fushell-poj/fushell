Future<void> openMainWindow() async {
  // Keep at most one window; a later invocation can reopen it after closing.
  if (ui.PlatformDispatcher.instance.views.any((view) => view.viewId != 0)) {
    return;
  }
  final id = await FushellWindow.openWindow(
    title: @@TITLE@@,
    appId: @@APPLICATION_ID@@,
    width: 800,
    height: 600,
  );
  await FushellWindow.viewById(id);
}
